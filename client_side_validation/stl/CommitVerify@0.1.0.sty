@context
typelib CommitVerify

import Std#sister-triton-cricket
  use U5#nebula-quarter-sharon


@mnemonic(morris-camel-famous)
data Commitment        : [Byte ^ 32]

@mnemonic(ultra-shake-aspirin)
data Leaf              : inhabited#16 (protocol ProtocolId, message Message)
                       | entropy (entropy U64, pos U32)

@mnemonic(swing-section-duet)
data MerkleBlock       : method Method
                       , depth Std.U5
                       , cofactor U16
                       , crossSection [TreeNode ^ 1..0xffffffff]
                       , entropy U64?

@mnemonic(magnum-jumbo-gentle)
data MerkleConcealed   : depth Std.U5
                       , cofactor U16
                       , merkleRoot MerkleHash

@mnemonic(ivory-spoon-imitate)
data MerkleHash        : [Byte ^ 32]

@mnemonic(pasta-nato-panama)
data MerkleNode        : branching NodeBranching
                       , depth U8
                       , width U256
                       , node1 MerkleHash
                       , node2 MerkleHash

@mnemonic(life-pretend-ammonia)
data MerkleProof       : method Method
                       , pos U32
                       , cofactor U16
                       , path [MerkleHash ^ ..0x20]

@mnemonic(cipher-medical-panama)
data MerkleTree        : method Method
                       , depth Std.U5
                       , entropy U64
                       , cofactor U16
                       , messages {ProtocolId -> ^ ..0xffffff Message}
                       , map {U32 -> ^ ..0xffffff ProtocolId, Message}

@mnemonic(baker-judge-miranda)
data Message           : [Byte ^ 32]

@mnemonic(horse-justice-select)
data Method            : blake3t | (|)


@mnemonic(video-summer-family)
data NodeBranching     : void | single | branch


