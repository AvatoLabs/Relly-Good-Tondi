@context
typelib UltraSONIC

import StrictTypes#claudia-bambino-organic
  use TypeName#passive-perfume-julius

import AluVM#event-parking-papa
  use LibSite#famous-prelude-magnet
  use LibId#forward-garbo-telex
  use CoreConfig#salon-sabrina-polka

import FiniteField#congo-wedding-pioneer
  use Fe256#farmer-forest-ammonia

import CommitVerify#clark-blonde-karma
  use ReservedBytes4#marina-libra-gopher
  use ReservedBytes1#marco-balsa-meaning
  use ReservedBytes6#quick-karl-numeric
  use ReservedBytes2#button-micro-fast

import Std#sister-triton-cricket
  use Bool#mustang-caravan-jester
  use AlphaNumLodash#marina-urban-omega
  use AlphaCapsLodash#acrobat-magic-consul
  use AsciiPrintable#valid-house-fame


@mnemonic(trumpet-queen-queen)
data AuthToken         : FiniteField.Fe256

@mnemonic(data-polka-barbara)
data CellAddr          : opid Opid, pos U16

@mnemonic(correct-flipper-alex)
data CellLock          : aux StateValue, script AluVM.LibSite?

@mnemonic(clock-juice-hilton)
data Codex             : version CommitVerify.ReservedBytes1
                       , name [Unicode ^ ..0xff]
                       , developer Identity
                       , timestamp I64
                       , features CommitVerify.ReservedBytes4
                       , fieldOrder U256
                       , verificationConfig AluVM.CoreConfig
                       , inputConfig AluVM.CoreConfig
                       , verifiers {U16 -> ^ ..0xff AluVM.LibSite}

@mnemonic(madrid-analyze-dynamic)
data CodexId           : [Byte ^ 32]

@mnemonic(anita-ground-union)
data Consensus         : tondi#48 | tondiTestnet


@mnemonic(shelter-alert-serpent)
data ContractId        : [Byte ^ 32]

@mnemonic(water-paprika-academy)
data ContractMeta      : testnet Std.Bool
                       , consensus Consensus
                       , timestamp I64
                       , features CommitVerify.ReservedBytes6
                       , name ContractName
                       , issuer Identity

@mnemonic(rainbow-evita-slalom)
data ContractName      : unnamed ()
                       | named StrictTypes.TypeName

@mnemonic(pamela-similar-alex)
data Genesis           : version CommitVerify.ReservedBytes1
                       , codexId CodexId
                       , callId U16
                       , nonce FiniteField.Fe256
                       , blank0 CommitVerify.ReservedBytes1
                       , blank1 CommitVerify.ReservedBytes2
                       , blank2 CommitVerify.ReservedBytes2
                       , destructibleOut [StateCell]
                       , immutableOut [StateData]

@mnemonic(vacuum-baby-domain)
data Identity          : Std.AsciiPrintable, [Std.AsciiPrintable ^ ..0xfff]

@mnemonic(decade-copy-joker)
data Input             : addr CellAddr, witness StateValue

@mnemonic(visa-novel-famous)
data Issue             : version CommitVerify.ReservedBytes1
                       , meta ContractMeta
                       , codex Codex
                       , genesis Genesis

@mnemonic(section-paper-eddie)
data Operation         : version CommitVerify.ReservedBytes1
                       , contractId ContractId
                       , callId U16
                       , nonce FiniteField.Fe256
                       , witness StateValue
                       , destructibleIn [Input]
                       , immutableIn [CellAddr]
                       , destructibleOut [StateCell]
                       , immutableOut [StateData]

@mnemonic(grid-baron-tornado)
data Opid              : [Byte ^ 32]

@mnemonic(axiom-join-aroma)
data RawData           : [Byte]

@mnemonic(village-spirit-laser)
data StateCell         : data StateValue
                       , auth AuthToken
                       , lock CellLock?

@mnemonic(thermos-pablo-data)
data StateData         : value StateValue, raw RawData?

@mnemonic(open-salsa-sonata)
data StateValue        : none ()
                       | single first FiniteField.Fe256
                       | double (first FiniteField.Fe256, second FiniteField.Fe256)
                       | triple (first FiniteField.Fe256
                       , second FiniteField.Fe256
                       , third FiniteField.Fe256)
                       | quadruple (first FiniteField.Fe256
                       , second FiniteField.Fe256
                       , third FiniteField.Fe256
                       , fourth FiniteField.Fe256)


