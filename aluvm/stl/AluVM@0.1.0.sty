@context
typelib AluVM

import Std#sister-triton-cricket
  use AlphaCapsNum#snake-telex-crack
  use Bool#mustang-caravan-jester


@mnemonic(salon-sabrina-polka)
data CoreConfig        : halt Std.Bool, complexityLim U64?

@mnemonic(avalon-harmony-sweet)
data IsaId             : Std.AlphaCapsNum, [Std.AlphaCapsNum ^ ..0xf]

@mnemonic(magnet-riviera-mambo)
data Lib               : isae {IsaId ^ ..0xff}
                       , code [Byte]
                       , data [Byte]
                       , libs {LibId ^ ..0xff}

@mnemonic(forward-garbo-telex)
data LibId             : [Byte ^ 32]

@mnemonic(magic-gentle-invite)
data LibSite           : libId LibId, offset U16


